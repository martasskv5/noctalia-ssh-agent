{
  "id": "ssh-agent",
  "name": "SSH Agent",
  "version": "0.0.1",
  "minNoctaliaVersion": "3.6.0",
  "author": "martasskv5",
  "license": "MIT",
  "repository": "https://github.com/martasskv5/noctalia-ssh-agent",
  "description": "A plugin that integrates SSH agent functionality into Noctalia, allowing users to manage their SSH keys and connections directly from the Noctalia interface.",
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "defaultSettings": {
      "socketPath": "",
      "sessionsFile": "~/.ssh/sessions.json",
      "terminalCommand": "",
      "showNotifications": true,
      "autoStartMode": "Connect Existing"
    }
  }
}